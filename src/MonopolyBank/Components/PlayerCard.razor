@* A player as a "Title Deed" card: colored header band, name, big balance. *@
<article class="deed deed-@Player.Color @(Big ? "deed-big" : "") @(Player.Bankrupt ? "is-bankrupt" : "")"
         data-testid="player-card" data-player="@Player.Name">
    <header class="deed-head">
        <span class="deed-label">@L["card.titleDeed"]</span>
        <h3 class="deed-name"><span class="deed-token" aria-hidden="true">@Player.Token</span>@Player.Name</h3>
    </header>
    <div class="deed-body">
        <span class="deed-caption">@L["card.balance"]</span>
        <div class="deed-balance @_flash" @key="_flashKey" style="--chars: @Money(Player.Balance).Length" data-testid="balance"><Money Amount="Player.Balance" /></div>
        @if (Player.Bankrupt)
        {
            <div class="stamp">@L["card.bankrupt"]</div>
        }
        else if (ChildContent is not null)
        {
            <div class="deed-actions">@ChildContent</div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = default!;
    [Parameter] public bool Big { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private long? _last;
    private string _flash = "";
    private int _flashKey;

    protected override void OnParametersSet()
    {
        if (_last is { } last && last != Player.Balance)
        {
            _flash = Player.Balance > last ? "flash-up" : "flash-down";
            _flashKey++;
        }
        _last = Player.Balance;
    }
}
