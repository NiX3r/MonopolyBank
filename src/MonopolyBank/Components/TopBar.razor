@* Red Monopoly-style header bar. Back = href of the back button (null = none, "" = home). *@
<header class="topbar">
    <div class="topbar-side">
        @if (Back is not null)
        {
            <a class="icon-btn on-red" href="@Back" aria-label="@L["common.back"]"><Icon Name="back" /></a>
        }
    </div>
    @if (Title is null)
    {
        <h1 class="logo-box small"><span>MONOPOLY</span><small>BANK</small></h1>
    }
    else
    {
        <h1 class="topbar-title">@Title</h1>
    }
    <div class="topbar-side end">@Actions</div>
</header>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Back { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
