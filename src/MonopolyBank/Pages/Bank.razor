@page "/bank"
@inject Browser Browser

<PageTitle>@L["bank.title"] · Monopoly Bank</PageTitle>

@if (Store.Shared is { } game)
{
    <TopBar Title="@L["bank.title"]" Back="">
        <Actions>
            <a class="icon-btn on-red" href="history" aria-label="@L["history.title"]" data-testid="history-link"><Icon Name="history" /></a>
            <a class="icon-btn on-red" href="settings" aria-label="@L["settings.title"]"><Icon Name="settings" /></a>
        </Actions>
    </TopBar>

    <main class="page bank" @ref="_root">
        @if (game.Settings.FreeParkingPot)
        {
            <section class="pot-card" data-party="@PotKey" data-testid="pot">
                <Coin Party="@PotKey" Label="@L["bank.coin", L["party.pot"]]" OnClick="() => OpenPay(Party.Pot, null)" />
                <div class="pot-info">
                    <span class="eyebrow">@L["party.pot"]</span>
                    <Money Amount="game.Pot" Class="pot-amount" />
                </div>
                <button class="btn btn-yellow" disabled="@(game.Pot == 0)" @onclick="() => OpenPay(Party.Pot, null, game.Pot)">@L["bank.collectPot"]</button>
            </section>
        }

        <p class="muted small drag-hint">@L["bank.dragHint"]</p>

        <div class="deed-grid">
            @* The bank plays along like a player: unlimited money, pays and collects. *@
            <article class="deed deed-bank" data-party="@BankKey" data-testid="bank-card">
                <header class="deed-head">
                    <span class="deed-label">@L["bank.cardLabel"]</span>
                    <h3 class="deed-name"><span class="deed-token" aria-hidden="true">🏦</span>@L["party.bank"]</h3>
                </header>
                <div class="deed-body">
                    <div class="deed-top">
                        <span class="deed-caption">@L["card.balance"]</span>
                        <Coin Party="@BankKey" Label="@L["bank.coin", L["party.bank"]]" OnClick="() => OpenPay(Party.Bank, null)" />
                    </div>
                    <div class="deed-balance" role="img" aria-label="@L["bank.unlimited"]" title="@L["bank.unlimited"]">∞</div>
                    <div class="deed-actions">
                        <button class="chip" @onclick="() => OpenPay(Party.Bank, null)" data-testid="pay"><Icon Name="send" Size="16" />@L["bank.pay"]</button>
                        <button class="chip" @onclick="() => OpenPay(null, Party.Bank)" data-testid="receive"><Icon Name="receive" Size="16" />@L["bank.receive"]</button>
                    </div>
                </div>
            </article>

            @foreach (var p in game.Players)
            {
                <PlayerCard Player="p" @key="p.Id" DropKey="@Key(Party.Of(p.Id))">
                    <Handle>
                        <Coin Party="@Key(Party.Of(p.Id))" Label="@L["bank.coin", p.Name]" OnClick="() => OpenPay(Party.Of(p.Id), null)" />
                    </Handle>
                    <ChildContent>
                    <button class="chip chip-go" @onclick="() => PassGo(p)" data-testid="go">
                        <Icon Name="go" Size="16" />@L["bank.go"] <Money Amount="game.Settings.GoSalary" Signed />
                    </button>
                    <button class="chip" @onclick="() => OpenPay(Party.Of(p.Id), null)" data-testid="pay"><Icon Name="send" Size="16" />@L["bank.pay"]</button>
                    <button class="chip" @onclick="() => OpenPay(Party.Bank, Party.Of(p.Id))" data-testid="receive"><Icon Name="receive" Size="16" />@L["bank.receive"]</button>
                    <button class="chip chip-icon" @onclick="() => _more = p" aria-label="@L["common.more"]" data-testid="more"><Icon Name="more" Size="16" /></button>
                    </ChildContent>
                </PlayerCard>
            }
        </div>
    </main>

    <Sheet @bind-Open="_payOpen" Title="@L["pay.title"]" Class="pay-sheet">
        <ChildContent>
        <div class="party-pick">
            <span class="party-label">@L["pay.from"]</span>
            <div class="chip-row" data-testid="from">
                @foreach (var party in Parties(game))
                {
                    <button class="chip @(party == _from ? "selected" : "")" @onclick="() => _from = party">@Label(game, party)</button>
                }
            </div>
        </div>
        <div class="party-pick">
            <span class="party-label">@L["pay.to"]</span>
            <div class="chip-row" data-testid="to">
                @foreach (var party in Parties(game))
                {
                    <button class="chip @(party == _to ? "selected" : "")" disabled="@(party == _from)" @onclick="() => _to = party">@Label(game, party)</button>
                }
            </div>
        </div>
        <MoneyPad @bind-Value="_amount" Hint="@(_from is { Kind: not PartyKind.Bank } f ? L["pay.available", Money(game.BalanceOf(f))] : null)" />
        </ChildContent>
        <Footer>
            <button class="btn btn-primary btn-lg btn-block" disabled="@(!CanPay)" @onclick="() => ConfirmPay(game)" data-testid="confirm-pay">
                @if (CanPay)
                {
                    @L["pay.confirm", Label(game, _from!), Label(game, _to!)] <Money Amount="_amount" />
                }
                else
                {
                    @L["pay.choose"]
                }
            </button>
        </Footer>
    </Sheet>

    <Sheet Open="_more is not null" OpenChanged="_ => CloseMore()" Title="@_more?.Name">
        <ChildContent>
        @if (_more is { } p)
        {
            <p class="muted">@L["bankrupt.explain", p.Name]</p>
            <div class="party-pick">
                <span class="party-label">@L["bankrupt.creditor"]</span>
                <div class="chip-row">
                    @foreach (var party in Parties(game).Where(x => x.Kind != PartyKind.Pot && x.PlayerId != p.Id))
                    {
                        <button class="chip @(party == _creditor ? "selected" : "")" @onclick="() => _creditor = party">@Label(game, party)</button>
                    }
                </div>
            </div>
        }
        </ChildContent>
        <Footer>
            <button class="btn btn-danger btn-block" @onclick="() => Bankrupt(game)" data-testid="confirm-bankrupt">
                <Icon Name="ban" />@L["bankrupt.confirm"]
            </button>
        </Footer>
    </Sheet>
}

@code {
    private const string BankKey = "bank", PotKey = "pot";
    private ElementReference _root;
    private DotNetObjectReference<Bank>? _self;
    private bool _payOpen;
    private Party? _from, _to;
    private long _amount;
    private Player? _more;
    private Party _creditor = Party.Bank;

    protected override void OnInitialized()
    {
        if (Store.Shared is null) Nav.NavigateTo("", replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_self is null && Store.Shared is not null)
        {
            _self = DotNetObjectReference.Create(this);
            await Browser.CoinDrag(_root, _self);
        }
    }

    /// <summary>Coin dropped on another party: open the payment with both sides picked, only the amount is left.</summary>
    [JSInvokable]
    public void OnCoinDrop(string from, string to)
    {
        if (Store.Shared is null || Parse(from) is not { } f || Parse(to) is not { } t || f == t) return;
        OpenPay(f, t);
        StateHasChanged();
    }

    private static string Key(Party p) => p.Kind switch
    {
        PartyKind.Bank => BankKey,
        PartyKind.Pot => PotKey,
        _ => p.PlayerId!.Value.ToString("N"),
    };

    private static Party? Parse(string key) => key switch
    {
        BankKey => Party.Bank,
        PotKey => Party.Pot,
        _ => Guid.TryParse(key, out var id) ? Party.Of(id) : null,
    };

    public override void Dispose()
    {
        _self?.Dispose();
        base.Dispose();
    }

    private bool CanPay => _from is not null && _to is not null && _from != _to && _amount > 0;

    private static IEnumerable<Party> Parties(SharedGame g)
    {
        yield return Party.Bank;
        if (g.Settings.FreeParkingPot) yield return Party.Pot;
        foreach (var p in g.ActivePlayers) yield return Party.Of(p.Id);
    }

    private string Label(SharedGame g, Party p) => p.Kind == PartyKind.Player
        ? $"{g.GetPlayer(p.PlayerId!.Value).Token} {L.PartyName(g, p)}"
        : L.PartyName(g, p);

    private void OpenPay(Party? from, Party? to, long amount = 0)
    {
        (_from, _to, _amount, _payOpen) = (from, to, amount, true);
    }

    private void CloseMore() => (_more, _creditor) = (null, Party.Bank);

    private Task PassGo(Player p) => Try(async () =>
    {
        var g = Store.Shared!;
        var tx = await Store.Run(() => g.PassGo(p.Id));
        Done(g, tx);
    });

    private Task ConfirmPay(SharedGame g) => Try(async () =>
    {
        var tx = await Store.Run(() => g.Pay(_from!, _to!, _amount));
        _payOpen = false;
        Done(g, tx);
    });

    private Task Bankrupt(SharedGame g) => Try(async () =>
    {
        var tx = await Store.Run(() => g.DeclareBankrupt(_more!.Id, _creditor));
        CloseMore();
        Done(g, tx);
    });

    /// <summary>Success toast with Undo (only while this is still the latest transaction).</summary>
    private void Done(SharedGame g, Transaction tx) =>
        Toasts.Show($"{L.Describe(g, tx)} · {Money(tx.Amount)}", ToastKind.Success, L["common.undo"], async () =>
        {
            if (g.History.LastOrDefault()?.Id != tx.Id) throw new BankException(BankError.CannotUndo);
            await Store.Run(() => g.Undo());
            Toasts.Show(L["history.undone"]);
        });
}
