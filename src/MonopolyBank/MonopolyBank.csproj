<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <Version>1.1.0</Version>
    <!-- Number formatting is done per language (i18n/*.json "_group"), so ICU data is not needed: smaller download. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonopolyBank.Core\MonopolyBank.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Languages: drop a new i18n/xx.json file here and it is picked up automatically. -->
    <EmbeddedResource Include="i18n\*.json" LogicalName="i18n/%(Filename)%(Extension)" />
    <!-- Token picker's full emoji list (Services/EmojiList.cs). -->
    <EmbeddedResource Include="Data\emoji.txt" LogicalName="emoji.txt" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
